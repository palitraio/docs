---
/**
 * A screenshot of the app with a caption. The image is looked up by `id` in
 * `src/assets/screenshots/<locale>/<id>.png`; until that file exists, a placeholder frame shows
 * the caption so the article still reads correctly.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { resolveLocale } from "@/locales.mjs";

interface Props {
  /** File name without extension, e.g. `chat-new-chat`. */
  id: string;
  /** What the screenshot shows; also the alt text and the caption. */
  alt: string;
}

const { id, alt } = Astro.props;
const locale = resolveLocale(process.env.SITE_LOCALE);
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/screenshots/*/*.png",
);
const load = images[`/src/assets/screenshots/${locale}/${id}.png`];
const image = load ? (await load()).default : null;
---

<figure class="screenshot not-content">
  {
    image ? (
      <Image src={image} alt={alt} widths={[720, 1440]} sizes="(min-width: 72rem) 720px, 100vw" />
    ) : (
      <div class="placeholder" role="img" aria-label={alt} data-screenshot-missing={id}>
        <span class="placeholder-id">{id}</span>
      </div>
    )
  }
  <figcaption>{alt}</figcaption>
</figure>

<style>
  .screenshot {
    margin-block: 1.5rem;
  }

  .screenshot :global(img),
  .placeholder {
    display: block;
    width: 100%;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 5%);
  }

  .screenshot :global(img) {
    height: auto;
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border-style: dashed;
    background: var(--sl-color-bg-inline-code);
  }

  .placeholder-id {
    color: var(--sl-color-gray-3);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
