---
import { Image } from "astro:assets";

import logo from "@/assets/palitra-logo.png";
import { LOCALES, resolveLocale } from "@/locales.mjs";

const { brand, section } = LOCALES[resolveLocale(process.env.SITE_LOCALE)];
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" translate="no">
  <Image src={logo} alt="" width={28} height={28} densities={[1, 2]} />
  <span class="brand">{brand}</span>
  <span class="divider" aria-hidden="true"></span>
  <span class="section">{section}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }

  img {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
  }

  .brand {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .divider {
    width: 1px;
    height: 1.125rem;
    background: var(--sl-color-hairline-light);
  }

  .section {
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: 0.9375rem;
    font-weight: 500;
  }
</style>
